# cp .env.example .env
#
# Secrets belong here


APP_PORT=8000

MONGO_DATABASE=webhook_inbox

# Dashboard admin.
# Leave the password empty and one is generated and printed once at first startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

LOG_LEVEL=INFO

# production overlay only
# Needed by compose.prod.yaml. Applied when the Mongo volume is first created.
# Use URL-safe passwords: they are embedded in the connection string.

MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=webhook_inbox
MONGO_APP_PASSWORD=
